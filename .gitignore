session-manager/cache.json
# per-session live-status records (hooks)
session-manager/state/
# your machine's paths & port
session-manager/config.json
session-manager/titler/corpus.jsonl
session-manager/titler/titles.jsonl
# 「建议」的复盘缓存
session-manager/advice.jsonl
# 解析失败时留下的模型原始输出
session-manager/advice_last_raw.txt
# 网页粘贴的图片
session-manager/uploads/
ticket-desk/tickets.json
ticket-desk/tickets.broken.*.json
ticket-desk/claude-skill/desk_path.txt

